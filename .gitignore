
# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*.pyo

# ==============================
# Virtual environments
# ==============================
.venv/
venv/

# ==============================
# DVC cache
# ==============================
.dvc/cache/

# ==============================
# Data files
# Actual datasets will be managed by DVC
# ==============================
DataInput/*
data/*

# Allow DVC metadata files inside data directories
!DataInput/**/*.dvc
!data/**/*.dvc

# ==============================
# Model and generated artifacts
# Actual artifacts will be managed by DVC when needed
# ==============================
artifacts/*

# Allow DVC metadata files
!artifacts/**/*.dvc

*.pkl
*.joblib
*.model
*.bin
*.ubj
*.skops

# ==============================
# Logs
# ==============================
*.log
artifacts/logs/

# ==============================
# MLflow
# ==============================
mlruns/
**/mlruns/
mlflow.db
mlflow.db-shm
mlflow.db-wal

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*

# ==============================
# IDE
# ==============================
.vscode/
.idea/
